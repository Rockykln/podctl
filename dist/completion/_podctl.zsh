#compdef podctl
# Generated by 'podctl completion' from the command table.
_podctl() {
    local -a cmds
    cmds=(
        'status:everything we know right now'
        'battery:left, right and case'
        'ping:daemon health check'
        'mode:listening mode'
        'conv:conversation awareness'
        'spatial:spatial audio'
        'ear:pause when a bud comes out'
        'mic:which buds microphone'
        'loud-reduction:cap loud spikes'
        'press:press-and-hold action'
        'tone-on-press:sound on press'
        'rename:change the bluetooth name'
        'one-bud-anc:keep ANC with one bud in'
        'auto-anc:AutoANC strength (Pro 2)'
        'chime:volume of the buds tones'
        'connect:bring the link up'
        'disconnect:drop the link'
        'pair:pair AirPods in pairing mode'
        'unpair:remove the pairing'
        'list:every paired AirPods'
        'auto-connect:BlueZ trusted flag'
        'volume:sink volume'
        'mute:mute the AirPods sink'
        'profile:bluetooth audio profile'
        'codec:A2DP codec'
        'default:make them the default sink'
        'latency:output latency offset'
        'watch:live event stream'
        'meter:live RMS / peak meter'
        'ble:listen for the case over LE'
        'tray:status-bar icon'
        'popup:show the case bubble now'
        'reboot:restart podctls services'
        'completion:completion script to stdout'
        'debug:diagnostic report'
        'install:install into ~/.local'
        'uninstall:remove what install added'
        'help:this list, or one command'
        'version:CLI and daemon version'
    )

    local -a aliases
    aliases=(
        's:status'
        'b:battery'
        'bat:battery'
        'm:mode'
        'c:conv'
        'ear-detection:ear'
        'loud:loud-reduction'
        'tone:tone-on-press'
        'obanc:one-bud-anc'
        'anc-strength:auto-anc'
        'chime-volume:chime'
        'dc:disconnect'
        'forget:unpair'
        'ls:list'
        'auto:auto-connect'
        'v:volume'
        'vol:volume'
        'p:profile'
        'default-sink:default'
        'w:watch'
    )

    local i vi=0 verb=""
    for (( i = 2; i < CURRENT; i++ )); do
        if [[ ${words[i]} != -* ]]; then verb=${words[i]}; vi=$i; break; fi
    done

    if [[ -z $verb ]]; then
        _describe -t commands 'podctl command' cmds
        _describe -t aliases 'alias' aliases
        return
    fi

    local argpos=$(( CURRENT - vi ))
    case $verb in
        mode|m)
            case $argpos in
                1) compadd off anc transparency adaptive ;;
            esac
            ;;
        conv|c)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        spatial)
            case $argpos in
                1) compadd off fixed head-tracked ;;
            esac
            ;;
        ear|ear-detection)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        mic)
            case $argpos in
                1) compadd auto left right ;;
            esac
            ;;
        loud-reduction|loud)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        press)
            case $argpos in
                1) compadd left right ;;
                2) compadd mode-cycle siri none ;;
            esac
            ;;
        tone-on-press|tone)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        one-bud-anc|obanc)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        pair)
            case $argpos in
                1) compadd --yes -y ;;
                *) compadd --yes -y ;;
            esac
            ;;
        auto-connect|auto)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        mute)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        profile|p)
            case $argpos in
                1) compadd high headset off ;;
            esac
            ;;
        codec)
            case $argpos in
                1) compadd sbc aac aptx aptx_hd ldac ;;
            esac
            ;;
        meter)
            case $argpos in
                1) compadd --plain --json --once --interval --device ;;
                *) compadd --plain --json --once --interval --device ;;
            esac
            ;;
        ble)
            case $argpos in
                1) compadd on off ;;
            esac
            ;;
        tray)
            case $argpos in
                1) compadd start stop status restart ;;
            esac
            ;;
        completion)
            case $argpos in
                1) compadd bash zsh fish ;;
            esac
            ;;
        debug)
            case $argpos in
                1) compadd --no-redact ;;
                *) compadd --no-redact ;;
            esac
            ;;
        install)
            case $argpos in
                1) compadd --yes -y --force --no-daemon --no-completion --no-manpages --no-tray --no-popup --with-tray --with-popup ;;
                *) compadd --yes -y --force --no-daemon --no-completion --no-manpages --no-tray --no-popup --with-tray --with-popup ;;
            esac
            ;;
        uninstall)
            case $argpos in
                1) compadd --yes -y --purge ;;
                *) compadd --yes -y --purge ;;
            esac
            ;;
        help)
            case $argpos in
                1) compadd status battery ping mode conv spatial ear mic loud-reduction press tone-on-press rename one-bud-anc auto-anc chime connect disconnect pair unpair list auto-connect volume mute profile codec default latency watch meter ble tray popup reboot completion debug install uninstall help version ;;
            esac
            ;;
    esac
}
_podctl "$@"
